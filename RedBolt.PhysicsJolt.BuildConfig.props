<Project>
  <PropertyGroup>
    <RedBoltPhysicsJoltEnabled Condition="$([System.String]::Copy('$(_RedBoltEnableModulesList)').Contains(',all,')) or $([System.String]::Copy('$(_RedBoltEnableModulesList)').Contains(',physics-jolt,'))">true</RedBoltPhysicsJoltEnabled>
    <RedBoltPhysicsJoltEnabled Condition="'$(RedBoltPhysicsJoltEnabled)' == '' and !$([System.String]::Copy('$(_RedBoltDisableModulesList)').Contains(',all,')) and !$([System.String]::Copy('$(_RedBoltDisableModulesList)').Contains(',physics-jolt,'))">true</RedBoltPhysicsJoltEnabled>
    <RedBoltPhysicsJoltEnabled Condition="'$(RedBoltPhysicsJoltEnabled)' == ''">false</RedBoltPhysicsJoltEnabled>
  </PropertyGroup>
</Project>
