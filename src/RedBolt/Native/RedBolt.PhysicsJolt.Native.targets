<Project>
  <PropertyGroup>
    <RedBoltPhysicsJoltCMakeTarget Condition="'$(RedBoltPlatform)' == 'linux-x64' or '$(RedBoltPlatform)' == 'win-x64'">redbolt-physics-jolt-native-all</RedBoltPhysicsJoltCMakeTarget>
    <RedBoltPhysicsJoltCMakeTarget Condition="'$(RedBoltPlatform)' == 'browser-wasm'">redbolt-physics-jolt-wasm-native</RedBoltPhysicsJoltCMakeTarget>
    <RedBoltPhysicsJoltCMakeTarget Condition="$([System.String]::Copy('$(RedBoltPlatform)').StartsWith('android-'))">redbolt-physics-jolt-android-native</RedBoltPhysicsJoltCMakeTarget>
  </PropertyGroup>
  <Target Name="RedBoltPhysicsJoltBuildNative" AfterTargets="Build" Condition="'$(RedBoltProjectBuildEnabled)' == 'true'">
    <Error Condition="'$(RedBoltNativePreset)' == ''" Text="No native preset is configured for '$(RedBoltPlatform)'." />
    <Error Condition="!Exists('$(RedBoltHostToolsOutputDir)/RedBolt.PhysicsJolt.Generator.Dependencies.dll')" Text="The RedBolt.PhysicsJolt dependency generator is missing." />
    <MakeDir Directories="$(RedBoltBuildRoot);$(RedBoltOutputDir);$(RedBoltIntermediateRoot);$(RedBoltNativeOutputRoot)" />
    <Exec WorkingDirectory="$(RedBoltPhysicsJoltRoot)" IgnoreStandardErrorWarningFormat="true"
          Command="cmake -E env ANDROID_NDK_ROOT=&quot;$(AndroidNdkDirectory)&quot; cmake -DREDBOLT_SOURCE_DIR=&quot;$(RedBoltPhysicsJoltRoot)&quot; -DREDBOLT_NATIVE_PRESET=&quot;$(RedBoltNativePreset)&quot; -DREDBOLT_NATIVE_BUILD_DIR=&quot;$(RedBoltNativeBuildDir)&quot; -DREDBOLT_NATIVE_TARGET=&quot;$(RedBoltPhysicsJoltCMakeTarget)&quot; -DREDBOLT_CONFIGURATION=&quot;$(Configuration)&quot; -DREDBOLT_ENABLED_NATIVE_MODULES=JOLT -DREDBOLT_SHARPCPP_ROOT=&quot;$(RedBoltSharpCppRoot)&quot; -DREDBOLT_GENERATOR_DLL=&quot;$(RedBoltHostToolsOutputDir)/RedBolt.PhysicsJolt.Generator.Dependencies.dll&quot; -DREDBOLT_RUNTIME_OUTPUT_DIR=&quot;$(RedBoltNativeOutputRoot)&quot; -DREDBOLT_PDB_OUTPUT_DIR=&quot;$(RedBoltNativePdbOutputRoot)&quot; -P &quot;$(MSBuildThisFileDirectory)BuildNative.cmake&quot;" />
    <Exec Condition="'$(RedBoltPlatform)' == 'linux-x64' and !Exists('$(RedBoltOutputRoot)/CoreData')" Command="cmake -E create_symlink &quot;$(RedBoltRoot)/bin/CoreData&quot; &quot;$(RedBoltOutputRoot)/CoreData&quot;" />
    <Exec Condition="'$(RedBoltPlatform)' == 'linux-x64' and !Exists('$(RedBoltOutputRoot)/Data')" Command="cmake -E create_symlink &quot;$(RedBoltRoot)/bin/Data&quot; &quot;$(RedBoltOutputRoot)/Data&quot;" />
    <Exec Condition="'$(RedBoltPlatform)' == 'linux-x64' and !Exists('$(RedBoltOutputRoot)/Base')" Command="cmake -E create_symlink &quot;$(RedBoltRoot)/build/bin/$(Configuration)/$(RedBoltPlatform)&quot; &quot;$(RedBoltOutputRoot)/Base&quot;" />
  </Target>
</Project>
