<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>RedBolt.PhysicsJolt</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(RedBoltRoot)/src/RedBolt/Core/RedBolt.Core.csproj" />
    <ProjectReference Include="../Native/JoltPhysics/RedBolt.Bindings.Jolt.csproj" />
    <ProjectReference Include="$(RedBoltRoot)/src/RedBolt/Generator/Reflection/RedBolt.Generator.Reflection.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      GlobalPropertiesToRemove="RedBoltPlatform;RedBoltNativePreset" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="$(RedBoltRoot)/src/RedBolt/Core/GlobalUsings.cs" Link="GlobalUsings.cs" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(RedBoltSharpCppRoot)/src/SharpCpp.Support/SharpCpp.Support.csproj"
                      PrivateAssets="all"
                      AdditionalProperties="$(RedBoltSharpCppManagedProperties)" />
  </ItemGroup>
</Project>
