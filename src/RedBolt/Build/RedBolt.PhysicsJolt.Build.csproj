<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <EnableDefaultItems>false</EnableDefaultItems>
    <Configuration Condition="'$(Configuration)' == ''">Debug</Configuration>
  </PropertyGroup>
  <ItemGroup>
    <_RedBoltExternalDesktopProject Include="../Native/RedBolt.PhysicsJolt.Native.csproj;../Native/JoltPhysics/RedBolt.Bindings.Jolt.csproj;../PhysicsJolt/RedBolt.PhysicsJolt.csproj;../PhysicsJolt.Network/RedBolt.PhysicsJolt.Network.csproj" Condition="'$(RedBoltPhysicsJoltEnabled)' == 'true'" />
    <_RedBoltExternalDesktopProject Include="../Sample/*/*.csproj" Exclude="../Sample/Android/*.csproj;../Sample/Web/*.csproj" Condition="'$(RedBoltSamplesEnabled)' == 'true'" />
    <_RedBoltExternalDesktopProject Include="$(RedBoltTestsProject)" Condition="'$(RedBoltTestsEnabled)' == 'true' and Exists('$(RedBoltTestsProject)')" />
    <_RedBoltExternalAndroidProject Include="../Native/RedBolt.PhysicsJolt.Native.Android.csproj;../Native/JoltPhysics/RedBolt.Bindings.Jolt.csproj;../PhysicsJolt/RedBolt.PhysicsJolt.csproj;../PhysicsJolt.Network/RedBolt.PhysicsJolt.Network.csproj" Condition="'$(RedBoltPhysicsJoltEnabled)' == 'true'" />
    <_RedBoltExternalAndroidProject Include="../Sample/Android/RedBolt.Sample.Android.csproj" Condition="'$(RedBoltSamplesEnabled)' == 'true'" />
    <_RedBoltExternalWebProject Include="../Native/RedBolt.PhysicsJolt.Native.Web.csproj;../Native/JoltPhysics/RedBolt.Bindings.Jolt.csproj;../PhysicsJolt/RedBolt.PhysicsJolt.csproj;../PhysicsJolt.Network/RedBolt.PhysicsJolt.Network.csproj" Condition="'$(RedBoltPhysicsJoltEnabled)' == 'true'" />
    <_RedBoltExternalWebProject Include="../Sample/Web/RedBolt.Sample.Web.csproj" Condition="'$(RedBoltSamplesEnabled)' == 'true'" />
  </ItemGroup>
  <Import Project="$(RedBoltRoot)/src/RedBolt/ExternalModule/Build.targets" />
</Project>
