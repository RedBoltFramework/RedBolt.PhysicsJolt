<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>RedBolt.PhysicsJolt.Sample.Android</AssemblyName>
    <ApplicationId>org.redbolt.physicsjolt.samples</ApplicationId>
    <RedBoltExternalAndroidNativeProject>$(RedBoltPhysicsJoltRoot)/src/RedBolt/Native/RedBolt.PhysicsJolt.Native.Android.csproj</RedBoltExternalAndroidNativeProject>
    <RedBoltExternalAndroidNativeOutput>$(RedBoltNativeOutputRoot)</RedBoltExternalAndroidNativeOutput>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../PhysicsJolt/RedBolt.PhysicsJolt.csproj" />
    <ProjectReference Include="../../PhysicsJolt.Network/RedBolt.PhysicsJolt.Network.csproj" />
    <ProjectReference Include="$(RedBoltRoot)/src/RedBolt/DearImGui/RedBolt.DearImGui.csproj" />
    <Reference Include="RedBolt.Bindings.DearImGui" HintPath="$(RedBoltBaseDearImGuiBindingAssembly)" />
    <ProjectReference Include="$(RedBoltNetworkRoot)/src/RedBolt/Network/RedBolt.Network.csproj" />
    <ProjectReference Include="../../Native/RedBolt.PhysicsJolt.Native.Android.csproj" ReferenceOutputAssembly="false" Private="false" PrivateAssets="all" />
    <Compile Include="../AdvancedNetworking/**/*.cs;../CharacterDemo/**/*.cs;../KinematicCharacter/**/*.cs;../Physics/**/*.cs;../RaycastVehicle/**/*.cs;../SceneReplication/**/*.cs" Link="Samples/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <Import Project="$(RedBoltRoot)/src/RedBolt/Build/AndroidSample.targets" />
</Project>
