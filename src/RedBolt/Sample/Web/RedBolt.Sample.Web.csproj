<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
  <PropertyGroup>
    <RedBoltExternalWebArchive>$(RedBoltNativeBuildDir)/lib/Release/wasm/RedBolt.PhysicsJolt.Native.Web.a</RedBoltExternalWebArchive>
    <RedBoltExternalWebPInvokeModules>RedBolt.Native.DearImGui;RedBolt.Native.Jolt</RedBoltExternalWebPInvokeModules>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../PhysicsJolt/RedBolt.PhysicsJolt.csproj" />
    <ProjectReference Include="../../PhysicsJolt.Network/RedBolt.PhysicsJolt.Network.csproj" />
    <ProjectReference Include="$(RedBoltRoot)/src/RedBolt/DearImGui/RedBolt.DearImGui.csproj" />
    <ProjectReference Include="$(RedBoltNetworkRoot)/src/RedBolt/Network/RedBolt.Network.csproj" />
    <Compile Include="../AdvancedNetworking/**/*.cs;../CharacterDemo/**/*.cs;../KinematicCharacter/**/*.cs;../Physics/**/*.cs;../RaycastVehicle/**/*.cs;../SceneReplication/**/*.cs" Link="Samples/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <Import Project="$(RedBoltRoot)/eng/RedBolt.ModuleBuild/WebSample.targets" />
</Project>
