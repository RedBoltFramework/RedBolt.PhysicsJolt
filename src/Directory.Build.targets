<Project>
  <Import Project="$(RedBoltRoot)/src/RedBolt/Build/Directory.Build.targets" />

  <Target Name="RedBoltPhysicsJoltConfigureProjectReferences"
          BeforeTargets="AssignProjectConfiguration"
          DependsOnTargets="IncludeTransitiveProjectReferences">
    <ItemGroup>
      <ProjectReference Update="@(ProjectReference)"
                        Condition="$([System.String]::Copy('%(ProjectReference.FullPath)').StartsWith('$(RedBoltRoot)/src/RedBolt/'))">
        <AdditionalProperties>%(ProjectReference.AdditionalProperties);RedBoltDearImGuiEnabled=true;RedBoltUtilityEnabled=true;RedBoltNetworkEnabled=true</AdditionalProperties>
      </ProjectReference>
      <ProjectReference Update="@(ProjectReference)"
                        Condition="'$(RedBoltPlatform)' == 'browser-wasm' and '%(ProjectReference.AdditionalProperties)' == '' and $([System.String]::Copy('%(ProjectReference.FullPath)').StartsWith('$(RedBoltPhysicsJoltRoot)/src/RedBolt/')) and '%(ProjectReference.Filename)' != 'RedBolt.PhysicsJolt.Generator.Dependencies' and '%(ProjectReference.Filename)' != 'RedBolt.PhysicsJolt.Native.Web'">
        <AdditionalProperties>RedBoltPlatform=browser-wasm;RedBoltNativePreset=browser-wasm</AdditionalProperties>
      </ProjectReference>
      <ProjectReference Update="@(ProjectReference)"
                        Condition="$([System.String]::Copy('$(RedBoltPlatform)').StartsWith('android-')) and '%(ProjectReference.AdditionalProperties)' == '' and $([System.String]::Copy('%(ProjectReference.FullPath)').StartsWith('$(RedBoltPhysicsJoltRoot)/src/RedBolt/')) and '%(ProjectReference.Filename)' != 'RedBolt.PhysicsJolt.Generator.Dependencies' and '%(ProjectReference.Filename)' != 'RedBolt.PhysicsJolt.Native.Android'">
        <AdditionalProperties>RedBoltPlatform=$(RedBoltPlatform);RedBoltNativePreset=$(RedBoltNativePreset);RedBoltTargetFramework=$(RedBoltTargetFramework)</AdditionalProperties>
      </ProjectReference>
    </ItemGroup>
  </Target>
</Project>
