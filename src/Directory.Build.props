<Project>
  <!--
    Module project evaluation. Native module depending on RedBolt.Network, with web and Android targets.
  -->
  <PropertyGroup>
    <RedBoltPhysicsJoltRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..'))</RedBoltPhysicsJoltRoot>
    <RedBoltRoot Condition="'$(RedBoltRoot)' == ''">$([System.IO.Path]::GetFullPath('$(RedBoltPhysicsJoltRoot)/../RedBolt'))</RedBoltRoot>
    <RedBoltNetworkRoot Condition="'$(RedBoltNetworkRoot)' == ''">$([System.IO.Path]::GetFullPath('$(RedBoltPhysicsJoltRoot)/../RedBolt.Network'))</RedBoltNetworkRoot>
    <RedBoltExternalModuleRoot>$(RedBoltPhysicsJoltRoot)</RedBoltExternalModuleRoot>
    <RedBoltExternalModuleName>RedBolt.PhysicsJolt</RedBoltExternalModuleName>
    <RedBoltExternalGeneratorProjectName>RedBolt.PhysicsJolt.Generator.Dependencies</RedBoltExternalGeneratorProjectName>
    <RedBoltExternalGeneratorProjectPrefix>RedBolt.PhysicsJolt.Generator.</RedBoltExternalGeneratorProjectPrefix>
    <RedBoltExternalGeneratedBindingsDirectory>redbolt-physics-jolt-native</RedBoltExternalGeneratedBindingsDirectory>
    <RedBoltExternalBindingsSubdirectory>jolt</RedBoltExternalBindingsSubdirectory>
    <RedBoltExternalBindingsProjectName>RedBolt.Bindings.Jolt</RedBoltExternalBindingsProjectName>
    <RedBoltExternalHasNative>true</RedBoltExternalHasNative>
    <RedBoltExternalNativeTargetPrefix>redbolt-physics-jolt</RedBoltExternalNativeTargetPrefix>
    <RedBoltExternalEnabledNativeModules>JOLT</RedBoltExternalEnabledNativeModules>
  </PropertyGroup>
  <Import Project="$(RedBoltRoot)/eng/RedBolt.ModuleBuild/Directory.Build.props" />
</Project>
